} ccmpThaiBindhuSraBelowReordering;

lookup ccmpThaiPaliSankritDescless {
  lookupflag 0;
    sub \uni0E0D by \uni0E0D.descless ;
    sub \uni0E10 by \uni0E10.descless ;
} ccmpThaiPaliSankritDescless;

lookup ccmpThaiDescless {
  lookupflag 0;
    sub [\uni0E0D \uni0E10 ]' [\uni0331 \uni0E38 \uni0E39 \uni0E3A ]  by [\uni0E0D.descless \uni0E10.descless ];
} ccmpThaiDescless;

lookup rligThaiHnaamx {
