feature ccmp {

 script DFLT;
     language dflt ;
      lookup ccmpThaiLowlineAbove;
      lookup ccmpThaiBindhuSraBelowReordering;
      lookup ccmpThaiDescless;
      lookup rligThaiHnaamx;
      lookup rcltThaiLongSraUabove;
      lookup rcltThaiLongabove;
      lookup rcltThaiabovehighleft;
      lookup rcltThaiabovelow;
      lookup rcltThaiSraEabove;
      lookup rcltThaibelow;
      lookup ccmpThaiAamxtty;

 script cyrl;
     language dflt ;
      lookup ccmpThaiLowlineAbove;
      lookup ccmpThaiBindhuSraBelowReordering;
      lookup ccmpThaiDescless;
      lookup rligThaiHnaamx;
      lookup rcltThaiLongSraUabove;
      lookup rcltThaiLongabove;
      lookup rcltThaiabovehighleft;
      lookup rcltThaiabovelow;
      lookup rcltThaiSraEabove;
      lookup rcltThaibelow;
      lookup ccmpThaiAamxtty;

 script grek;
     language dflt ;
      lookup ccmpThaiLowlineAbove;
      lookup ccmpThaiBindhuSraBelowReordering;
      lookup ccmpThaiDescless;
      lookup rligThaiHnaamx;
      lookup rcltThaiLongSraUabove;
      lookup rcltThaiLongabove;
      lookup rcltThaiabovehighleft;
      lookup rcltThaiabovelow;
      lookup rcltThaiSraEabove;
      lookup rcltThaibelow;
      lookup ccmpThaiAamxtty;

 script lao ;
     language dflt ;
      lookup ccmpThaiLowlineAbove;
      lookup ccmpThaiBindhuSraBelowReordering;
      lookup ccmpThaiDescless;
      lookup rligThaiHnaamx;
      lookup rcltThaiLongSraUabove;
      lookup rcltThaiLongabove;
      lookup rcltThaiabovehighleft;
      lookup rcltThaiabovelow;
      lookup rcltThaiSraEabove;
      lookup rcltThaibelow;
      lookup ccmpThaiAamxtty;
     language LAO  exclude_dflt;
      lookup ccmpThaiLowlineAbove;
      lookup ccmpThaiBindhuSraBelowReordering;
      lookup ccmpThaiDescless;
      lookup rligThaiHnaamx;
      lookup rcltThaiLongSraUabove;
      lookup rcltThaiLongabove;
      lookup rcltThaiabovehighleft;
      lookup rcltThaiabovelow;
