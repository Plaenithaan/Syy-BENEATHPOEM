# GSUB 


lookup ThaiLowlineTone1 {
  lookupflag 0;
    sub \uni0E48 by \uni0331 ;
    sub \uni0331 by \uni0E48 ;
} ThaiLowlineTone1;

lookup ThaiLowlineTone2 {
  lookupflag 0;
    sub \uni0E49 by \uni0331 ;
    sub \uni0331 by \uni0E49 ;
} ThaiLowlineTone2;

lookup ThaiLowlineTone3 {
  lookupflag 0;
    sub \uni0E4A by \uni0331 ;
    sub \uni0331 by \uni0E4A ;
} ThaiLowlineTone3;

lookup ThaiLowlineTone4 {
  lookupflag 0;
    sub \uni0E4B by \uni0331 ;
    sub \uni0331 by \uni0E4B ;
} ThaiLowlineTone4;

lookup ccmpThaiLowlineAbove {
  lookupflag 0;
    sub  \uni0E48'lookup ThaiLowlineTone1  \uni0331'lookup ThaiLowlineTone1  ;
    sub  \uni0E49'lookup ThaiLowlineTone2  \uni0331'lookup ThaiLowlineTone2  ;
    sub  \uni0E4A'lookup ThaiLowlineTone3  \uni0331'lookup ThaiLowlineTone3  ;
    sub  \uni0E4B'lookup ThaiLowlineTone4  \uni0331'lookup ThaiLowlineTone4  ;
} ccmpThaiLowlineAbove;

